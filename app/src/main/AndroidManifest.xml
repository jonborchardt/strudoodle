<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for strudel's samples(...) sample packs, streamed from the Strudel CDN. The hello-world synth pattern is offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the page's buzz when a new A/B test lands (android.vibrate) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Listen: the page's getUserMedia, granted through WebChromeClient.onPermissionRequest. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WebView's getUserMedia fails with "Could not start audio source" without this one too. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:label="Strudoodle"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
